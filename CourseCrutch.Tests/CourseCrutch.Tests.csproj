<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CourseCrutch.Logging\CourseCrutch.Logging.csproj" />
    <ProjectReference Include="..\CourseCrutch.Application\CourseCrutch.Application.csproj" />
    <ProjectReference Include="..\CourseCrutch.Infrastructure\CourseCrutch.Infrastructure.csproj" />
    <ProjectReference Include="..\CourseCrutch.API\CourseCrutch.API.csproj" />
  </ItemGroup>

  <!-- Clients targets MAUI platforms only, so its MAUI-free API client is compiled in directly -->
  <ItemGroup>
    <Compile Include="..\CourseCrutch.Clients\Models\OcrContracts.cs" Link="Linked\Clients\OcrContracts.cs" />
    <Compile Include="..\CourseCrutch.Clients\Services\IOcrApiClient.cs" Link="Linked\Clients\IOcrApiClient.cs" />
    <Compile Include="..\CourseCrutch.Clients\Services\OcrApiClient.cs" Link="Linked\Clients\OcrApiClient.cs" />
  </ItemGroup>

</Project>